# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Node.js dependencies
node_modules/
**/node_modules/
.pnp
.pnp.*

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build outputs
frontend/.next/*
backend/build/
out/
build/
dist/

# Testing coverage
coverage/
frontend/.next/*
# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS-specific files
.DS_Store
Thumbs.db

# Environment variables
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel/

# ESLint cache
.eslintcache

# Prettier
.prettier-cache/

# Lock files (optional, if you don't want to include lock files in the repo)
package-lock.json
yarn.lock

# Miscellaneous
*.pem
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
